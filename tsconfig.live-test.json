{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "noEmit": true
  },
  "include": ["live-test/**/*", "src/utils/**/*", "src/types/**/*"],
  // jsdom/localStorage test for the extension jest project; needs DOM types this config omits.
  "exclude": ["src/utils/debugLog.test.ts"]
}
